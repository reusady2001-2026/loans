{
  "name": "loan-debt-service-hub",
  "version": "2.4.3",
  "description": "Commercial Loan Debt Service Hub — offline desktop app",
  "main": "main.js",
  "author": "BSI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --publish never",
    "build:win-installer": "electron-builder --win nsis --publish never",
    "build:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "il.co.bsi.loandebtservice",
    "productName": "Loan Debt Service Hub",
    "copyright": "© 2026 BSI",
    "artifactName": "LoanDebtServiceHub-Setup-${version}.${ext}",
    "files": [
      "index.html",
      "underwriting.js",
      "t12-classify.js",
      "setup-builder.js",
      "t12-parse.js",
      "ai.js",
      "main.js",
      "preload.js",
      "vendor/**/*",
      "node_modules/@anthropic-ai/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "reusady2001-2026",
        "repo": "loans"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loan Debt Service Hub",
      "uninstallDisplayName": "Loan Debt Service Hub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.247",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "electron-updater": "^6.8.9"
  }
}
